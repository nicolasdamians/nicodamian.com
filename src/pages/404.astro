---
import Base from '@/layouts/Base.astro';
---

<Base title="404 | Nicolás Damián Sadofschi" noindex>
  <section class="mx-auto max-w-[70rem] px-5 py-24 md:px-8 lg:px-12">
    <p class="label"><span class="text-accent">$</span> stat {Astro.url.pathname}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">No such file or directory</h1>
    <p class="mt-4 text-muted">That page does not exist. The rest of the site does.</p>
    <a href="/" class="link mt-8 inline-block font-mono">cd ~</a>
  </section>
</Base>
