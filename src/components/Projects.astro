---
import { ArrowUpRight } from '@lucide/astro';
import Section from './Section.astro';
import Text from './Text.astro';
import { projects } from '@/data/projects';
import type { Project } from '@/data/types';

const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);

const groups: { heading: string; items: readonly Project[]; large: boolean }[] = [
  { heading: 'Running today', items: featured, large: true },
  { heading: 'Also built', items: rest, large: false },
];
---

<Section
  id="projects"
  title="Things I built, and still run"
  lead="Built for real use, on hardware I pay for and patch. Internal details stay internal; the design is what I can show."
>
  {
    groups.map((group) => (
      <>
        <h3 class="label mt-12 mb-5 first:mt-0">{group.heading}</h3>
        <ul class:list={['grid gap-4', group.large ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3']}>
          {group.items.map((project) => (
            <li class="sheet reveal flex flex-col p-5 md:p-6">
              <p class="label">
                <span class="text-accent">{project.kind}</span>
              </p>
              <h4 class:list={['mt-2 leading-snug font-semibold', group.large ? 'text-xl' : 'text-lg']}>
                {project.title}
              </h4>
              <p class="mt-3 flex-1 text-muted">{project.summary}</p>
              {project.credit && (
                <p class="mt-3 text-sm text-faint">
                  <Text value={project.credit} />
                </p>
              )}
              <ul class="mt-5 flex flex-wrap gap-2 font-mono text-xs text-faint">
                {project.stack.map((tag) => (
                  <li class="border border-line px-2 py-0.5">{tag}</li>
                ))}
              </ul>
              {project.link && (
                <a
                  href={project.link.href}
                  rel="noopener noreferrer"
                  class="link mt-5 inline-flex items-center gap-1 self-start font-mono text-sm"
                >
                  {project.link.label}
                  <ArrowUpRight size={14} />
                </a>
              )}
            </li>
          ))}
        </ul>
      </>
    ))
  }
</Section>
