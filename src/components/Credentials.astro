---
import { GraduationCap, ShieldCheck } from '@lucide/astro';
import Section from './Section.astro';
import { credentials, skills } from '@/data/credentials';

const featured = credentials.filter((item) => item.featured);
const register = credentials.filter((item) => !item.featured);
---

<Section id="credentials" title="Certifications & skills">
  <ul class="mb-12 grid gap-5 lg:grid-cols-3">
    {
      featured.map((cert) => (
        <li class="ticks reveal flex flex-col bg-surface p-6">
          {cert.id === 'master' ? (
            <GraduationCap size={36} class="text-accent" />
          ) : (
            <ShieldCheck size={36} class="text-accent" />
          )}
          <p class="label mt-4">{cert.issuer}</p>
          <h3 class="mt-1 font-mono text-2xl leading-tight font-semibold tracking-tight">{cert.name}</h3>
          {cert.note && <p class="mt-3 flex-1 text-muted">{cert.note}</p>}
          {cert.issued && <p class="meta mt-3">{cert.issued}</p>}
          {cert.verifyUrl && (
            <a href={cert.verifyUrl} rel="noopener noreferrer" class="btn-ghost mt-5 self-start">
              Verify {cert.name}
            </a>
          )}
        </li>
      ))
    }
  </ul>

  <div class="reveal overflow-x-auto">
    <table class="w-full border-y border-line text-left">
      <caption class="label pb-3 text-left">Also earned</caption>
      <thead class="label border-b border-line">
        <tr>
          <th scope="col" class="py-2 pr-4 font-medium">Credential</th>
          <th scope="col" class="py-2 pr-4 font-medium">Issuer</th>
          <th scope="col" class="py-2 font-medium">Held</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {
          register.map((cert) => (
            <tr>
              <th scope="row" class="py-3 pr-4 font-medium">
                {cert.name}
              </th>
              <td class="py-3 pr-4 text-muted">{cert.issuer}</td>
              <td class="meta py-3 whitespace-nowrap">{cert.issued ?? '—'}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h3 class="label mt-14 mb-5">Skills</h3>
  <div class="grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
    {
      skills.map((group) => (
        <div class="reveal">
          <h4 class="border-b border-line pb-2 font-semibold">{group.label}</h4>
          <ul class="mt-3 space-y-1 font-mono text-[0.8125rem] text-muted">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
