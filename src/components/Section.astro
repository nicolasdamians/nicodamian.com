---
import { site } from '@/data/site';
import type { SectionId } from '@/data/types';

interface Props {
  id: SectionId;
  title: string;
  lead?: string;
}

const { id, title, lead } = Astro.props;
const position = site.nav.findIndex((item) => item.id === id) + 1;
const index = String(position).padStart(2, '0');
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line">
  <div class="mx-auto max-w-[70rem] px-5 py-18 md:px-8 md:py-24 lg:px-12">
    <header class="reveal mb-12 max-w-[62ch]">
      <p class="label mb-3"><span class="text-accent">§ {index}</span> / {id}</p>
      <h2 id={`${id}-title`} class="text-2xl leading-tight font-semibold tracking-tight md:text-[1.75rem]">{title}</h2>
      {lead && <p class="mt-3 text-muted">{lead}</p>}
    </header>
    <slot />
  </div>
</section>
