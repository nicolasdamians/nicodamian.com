---
import Section from './Section.astro';
import { profile } from '@/data/profile';

const rows = [
  ['Login name', profile.pinky.login],
  ['In real life', profile.pinky.realName],
  ['Directory', profile.pinky.directory],
  ['Shell', profile.pinky.shell],
] as const;
---

<Section id="about" title="Twenty years of keeping other people’s systems up. Now I also know how they fall.">
  <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="reveal max-w-[62ch] space-y-6 text-[1.0625rem] leading-[1.65] text-muted lg:col-span-7">
      {profile.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <aside class="reveal lg:col-span-5">
      <div class="sheet">
        <p class="label border-b border-line px-4 py-2.5">
          <span class="text-accent">$</span> pinky -l {profile.pinky.login}
        </p>
        <dl class="divide-y divide-line font-mono text-[0.8125rem]">
          {
            rows.map(([term, value]) => (
              <div class="grid grid-cols-[14ch_1fr] gap-3 px-4 py-2">
                <dt class="text-faint">{term}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <blockquote class="mt-6 border-l-2 border-accent pl-4 text-muted italic">“{profile.motto}”</blockquote>
    </aside>
  </div>

  <h3 class="label mt-16 mb-6"><span class="text-accent">$</span> history | head · how it started</h3>
  <ol class="grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-5">
    {
      profile.origin.map((step, i) => (
        <li class="reveal bg-bg p-5">
          <p class="meta">
            <span class="text-accent">{String(i + 1).padStart(2, '0')}</span> · {step.when}
          </p>
          <h4 class="mt-2 font-semibold">{step.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>
</Section>
