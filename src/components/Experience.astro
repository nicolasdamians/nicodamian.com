---
import Section from './Section.astro';
import Text from './Text.astro';
import { education, experience } from '@/data/experience';
import { formatRange } from '@/lib/dates';
---

<Section
  id="experience"
  title="Experience"
  lead="From a repair bench to the firewalls of Swiss financial infrastructure."
>
  <ol class="divide-y divide-line border-y border-line">
    {
      experience.map((job) => (
        <li class="reveal grid gap-2 py-7 md:grid-cols-[18ch_1fr] md:gap-8">
          <p class="meta pt-0.5">
            {job.yearsOnly ? `${job.start.slice(0, 4)} – ${job.end.slice(0, 4)}` : formatRange(job.start, job.end)}
          </p>
          <div>
            <h3 class="text-lg leading-snug font-semibold">
              {job.role}
              <span class="font-normal text-muted"> · {job.company}</span>
            </h3>
            <p class="meta mt-1">{job.location}</p>
            <p class="mt-3 max-w-[62ch] text-muted">{job.summary}</p>
            <ul class="mt-3 max-w-[62ch] space-y-1.5 text-muted">
              {job.highlights.map((item) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="font-mono text-accent">
                    ›
                  </span>
                  <span>
                    <Text value={item} />
                  </span>
                </li>
              ))}
            </ul>
            {job.stack && (
              <ul class="mt-4 flex flex-wrap gap-2 font-mono text-xs text-faint">
                {job.stack.map((tag) => (
                  <li class="border border-line px-2 py-0.5">{tag}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <h3 class="label mt-12 mb-4">Education</h3>
  <ul class="grid gap-4 md:grid-cols-2">
    {
      education.map((item) => (
        <li class="sheet reveal p-5">
          <p class="meta">{item.years}</p>
          <p class="mt-1 font-semibold">{item.title}</p>
          <p class="text-muted">{item.school}</p>
        </li>
      ))
    }
  </ul>
</Section>
