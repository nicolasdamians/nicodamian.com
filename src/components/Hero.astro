---
import { Image } from 'astro:assets';
import { ArrowDown, Terminal } from '@lucide/astro';
import portrait from '@/assets/portrait.jpg';
import { profile } from '@/data/profile';
import { site } from '@/data/site';
import { projects } from '@/data/projects';
import { credentials } from '@/data/credentials';
import type { TerminalContext } from '@/lib/terminal';

// Everything the terminal can print is plain data, serialised once into a data attribute.
const context: TerminalContext = {
  sections: site.nav.map((item) => item.id),
  whoami: [profile.name, ...profile.whoami],
  files: {
    'about.txt': profile.about,
    'certs.txt': credentials.map((cert) => `${cert.name}  (${cert.issuer})`),
    'projects.txt': projects.map((project) => `${project.kind.padEnd(15)}${project.title}`),
    'motto.txt': [profile.motto],
  },
};
---

<section id="top" aria-labelledby="hero-title" class="hero-glow">
  <div class="mx-auto max-w-[70rem] px-5 py-12 md:px-8 md:py-20 lg:px-12">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <div class="term" data-terminal data-context={JSON.stringify(context)}>
          <div class="term-bar">
            <span class="term-dot bg-[#ff5f57]"></span>
            <span class="term-dot bg-[#febc2e]"></span>
            <span class="term-dot bg-[#28c840]"></span>
            <span class="ml-3 font-mono text-xs text-faint">{profile.handle}@zrh:~</span>
          </div>
          <div class="term-body">
            <p><span class="text-accent">$</span> whoami</p>
            <h1 id="hero-title" class="term-name">
              <span class="text-accent" aria-hidden="true">&gt;</span>{' '}
              {profile.name}
            </h1>
            {
              profile.whoami.map((line) => (
                <p>
                  <span class="text-accent" aria-hidden="true">
                    &gt;
                  </span>{' '}
                  {line}
                </p>
              ))
            }
            <div data-terminal-output aria-live="polite" class="mt-3 space-y-0.5"></div>
            <form data-terminal-form class="term-prompt" autocomplete="off">
              <label for="term-input" class="shrink-0">
                <span class="text-accent">{profile.handle}@zrh</span><span class="text-faint">:~$</span>
                <span class="sr-only">Terminal command. Type help and press Enter.</span>
              </label>
              <input
                id="term-input"
                data-terminal-input
                type="text"
                name="command"
                spellcheck="false"
                autocapitalize="off"
                autocomplete="off"
                placeholder="type &quot;help&quot;"
                class="min-w-0 flex-1 bg-transparent font-mono text-fg caret-accent placeholder:text-faint"
              />
            </form>
          </div>
        </div>

        <p class="mt-8 max-w-[56ch] text-lg leading-[1.6] text-muted">{profile.tagline}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#projects" class="btn-primary">
            <Terminal size={16} /> See what I build <ArrowDown size={16} />
          </a>
          <a href="#experience" class="btn-ghost">Experience</a>
          <a href="#contact" class="btn-ghost">Get in touch</a>
        </div>
      </div>

      <aside class="lg:col-span-4">
        <div class="sheet">
          <Image
            src={portrait}
            alt={profile.photoAlt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 22rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="aspect-square w-full object-cover"
          />
          <dl class="divide-y divide-line border-t border-line font-mono text-[0.8125rem]">
            {
              profile.facts.map((fact) => (
                <div class="grid grid-cols-[11ch_1fr] gap-3 px-4 py-2">
                  <dt class="text-faint uppercase">{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>

    <ul class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        profile.stats.map((stat) => (
          <li class="stat">
            <p class="font-mono text-3xl font-semibold text-accent tabular-nums">{stat.value}</p>
            <p class="mt-1 text-sm text-muted">{stat.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
